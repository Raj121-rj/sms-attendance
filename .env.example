# Postgres connection string (Neon or Supabase "Session pooler")
DATABASE_URL=postgresql://user:password@host:5432/dbname
# 32+ random characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-32-chars-min
# development locally, production when deployed
NODE_ENV=development
